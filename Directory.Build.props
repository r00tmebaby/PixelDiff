<Project>

  <!--
    Settings shared by every project. Individual projects override TargetFramework
    when they need the Windows surface area for screen capture.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Analysis">
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Repository">
    <Authors>r00tmebaby</Authors>
    <Product>PixelDiff</Product>
    <Version>0.1.0</Version>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
