<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PixelDiff.App.ViewModels"
        xmlns:cap="using:PixelDiff.Capture.Windows"
        x:Class="PixelDiff.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PixelDiff"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="560">

  <Grid RowDefinitions="*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="380,Auto,*">

      <!-- Suite pane -->
      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="12">
        <StackPanel Grid.Row="0" Spacing="8">
          <TextBlock Text="Suite folder" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" Text="{Binding SuiteRoot}" IsReadOnly="True" />
            <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseSuiteCommand}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Run selected" Command="{Binding RunSelectedCommand}" />
            <Button Content="Run all" Command="{Binding RunAllCommand}" />
            <Button Content="Reload" Command="{Binding RefreshSuiteCommand}" />
          </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,10" Padding="10" CornerRadius="6"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="New baseline" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Windows}"
                        SelectedItem="{Binding SelectedWindow}"
                        PlaceholderText="Choose a window to capture">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="cap:CapturableWindow">
                    <TextBlock TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Title}" />
                      <Run Text="&#160;&#160;" /><Run Text="{Binding ProcessName}" Foreground="#99FFFFFF" />
                    </TextBlock>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshWindowsCommand}" />
            </Grid>
            <TextBox Text="{Binding NewBaselineName}" PlaceholderText="Baseline name" />
            <TextBlock Text="{Binding NameError}" IsVisible="{Binding HasNameError}"
                       Foreground="#F85149" TextWrapping="Wrap" />
            <Button Content="Capture baseline" Command="{Binding CaptureBaselineCommand}" />
          </StackPanel>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BaselineRowViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                         Fill="{Binding StatusBrush}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding TargetDescription}" FontSize="11" Opacity="0.65"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{Binding StatusBrush}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />

      <!-- Viewer pane -->
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <ComboBox Grid.Column="0" MinWidth="140"
                    ItemsSource="{x:Static vm:MainWindowViewModel.ViewModes}"
                    SelectedItem="{Binding ViewMode}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button Content="Approve candidate" Command="{Binding ApproveCommand}" />
            <Button Content="Delete" Command="{Binding RequestDeleteCommand}"
                    IsVisible="{Binding !IsDeleteArmed}" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDeleteArmed}">
              <TextBlock Text="Delete this baseline?" VerticalAlignment="Center" />
              <Button Content="Confirm delete" Command="{Binding DeleteCommand}" Foreground="#F85149" />
              <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,10" Padding="10" CornerRadius="6"
                IsVisible="{Binding HasResult}"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}">
          <WrapPanel>
            <StackPanel Margin="0,0,24,0">
              <TextBlock Text="Outcome" FontSize="11" Opacity="0.65" />
              <TextBlock Text="{Binding OutcomeText}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Margin="0,0,24,0">
              <TextBlock Text="Changed pixels" FontSize="11" Opacity="0.65" />
              <TextBlock Text="{Binding ChangedPixelsText}" />
            </StackPanel>
            <StackPanel Margin="0,0,24,0">
              <TextBlock Text="Changed ratio" FontSize="11" Opacity="0.65" />
              <TextBlock Text="{Binding ChangedRatioText}" />
            </StackPanel>
            <StackPanel Margin="0,0,24,0">
              <TextBlock Text="Changed areas" FontSize="11" Opacity="0.65" />
              <TextBlock Text="{Binding ChangedAreasText}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>
          </WrapPanel>
        </Border>

        <Border Grid.Row="2" CornerRadius="6" ClipToBounds="True" Background="#0D1117">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image Source="{Binding CurrentImage}" Stretch="None"
                   HorizontalAlignment="Left" VerticalAlignment="Top" />
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="1" Padding="12,6"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="1" Width="120" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>
  </Grid>
</Window>
